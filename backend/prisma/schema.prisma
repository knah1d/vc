generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  sentMessages     Message[] @relation("SentMessages")
  conversationsA   Conversation[] @relation("ConversationUserA")
  conversationsB   Conversation[] @relation("ConversationUserB")
  callsAsCaller    Call[] @relation("CallCaller")
  callsAsCallee    Call[] @relation("CallCallee")
  deviceTokens     DeviceToken[]
  reactions        MessageReaction[]
}

// One row per device that has registered for push (e.g. an Expo push token
// from the mobile app). Lets the backend reach a user who has no live
// socket connection — a backgrounded or killed app — for things like an
// incoming call ring or a new message.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id])
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id])
  createdAt DateTime @default(now())

  messages Message[]
  calls    Call[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  // Client-generated id from the sending device's local outbox. Lets a retried
  // send (e.g. after a dropped ack on a flaky mobile connection) be recognized
  // as the same message instead of creating a duplicate.
  clientId       String?      @unique
  reactions      MessageReaction[]
  // Optional photo/file attachment, stored externally (R2) — attachmentUrl is
  // a plain public URL, not proxied through this server.
  attachmentUrl  String?
  attachmentType String? // "image" | "file"
  attachmentName String? // original filename, for non-image downloads

  @@index([conversationId, createdAt])
}

// One reaction per user per message — reacting again with a different emoji
// replaces it, reacting with the same emoji again removes it (toggle).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

enum CallStatus {
  MISSED
  DECLINED
  COMPLETED
}

model Call {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  callerId       String
  caller         User         @relation("CallCaller", fields: [callerId], references: [id])
  calleeId       String
  callee         User         @relation("CallCallee", fields: [calleeId], references: [id])
  status         CallStatus?
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
}
