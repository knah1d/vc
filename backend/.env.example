DATABASE_URL="postgresql://user:password@localhost:5432/vc?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Local LiveKit: run `docker compose up -d livekit` from the project root.
# For LiveKit Cloud, replace all three values using your project's settings.
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="ws://localhost:7880"

# Cloudflare R2 (S3-compatible) — for photo/file attachments. Create a bucket
# at https://dash.cloudflare.com > R2, enable public access on it, and create
# an API token scoped to that bucket for the access key/secret below.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# The bucket's public base URL (the r2.dev URL shown when you enable public
# access, or your own custom domain if you attached one).
R2_PUBLIC_URL=""
